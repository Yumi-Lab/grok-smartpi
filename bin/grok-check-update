#!/bin/sh
# grok-check-update — one JSON line: installed vs the release the installer is
# pinned to (GROK_PIN in lib/grok-release.sh on GitHub's main branch).
#   {"cli":"grok","installed":"v1.0.45","latest":"v1.0.45","update_available":false}
#
# Contract shared by every Yumi-Lab/*-smartpi repo (<cli>-check-update): no
# sudo, no side effects, fast; "installed"/"latest" are null when unknown
# (offline, not installed). The Yumi AI Gateway polls this to light its update
# badge, then re-runs install.sh to actually update.
#
# Installed source of truth: /opt/grok/VERSION (written by install.sh).
# Latest: GROK_PIN on main — exactly what re-running the installer delivers, so
# the badge lights up when a new release is validated and pinned, never for a
# test snapshot. Parsed, not sourced: the probe runs no downloaded code.

OPT="/opt/grok"
LIB="$OPT/lib/grok-release.sh"
[ -f "$LIB" ] || LIB="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)/grok-release.sh"
# shellcheck source=SCRIPTDIR/../lib/grok-release.sh
. "$LIB"

installed="$(cat "$OPT/VERSION" 2>/dev/null)"
case "$installed" in *[!0-9a-zA-Z.-]*|"") installed="" ;; esac

latest="$(curl -fsSL --max-time 10 "$GROK_RAW/lib/grok-release.sh" 2>/dev/null \
  | sed -n 's/^GROK_PIN=//p')"
case "$latest" in *[!0-9a-zA-Z.-]*|"") latest="" ;; esac

up=false
[ -n "$installed" ] && [ -n "$latest" ] && [ "$installed" != "$latest" ] && up=true

j() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }
printf '{"cli":"grok","installed":%s,"latest":%s,"update_available":%s}\n' \
  "$(j "$installed")" "$(j "$latest")" "$up"
