diff --git a/.cargo/config.toml b/.cargo/config.toml
index 912e93e..221268d 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -64,6 +64,12 @@ rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"
 [target.aarch64-pc-windows-msvc]
 rustflags = ["-C", "force-unwind-tables=yes", "-C", "target-feature=+crt-static"]
 
+# --- Local addition: 32-bit ARM (armv7l, SmartPi One / Allwinner H3) cross-build
+# from macOS via zig as C cross-compiler/linker (see tools/cross/).
+[target.armv7-unknown-linux-gnueabihf]
+linker = "@GROK_ROOT@/tools/cross/zigcc-armv7.sh"
+rustflags = ["-C", "force-unwind-tables=yes"]
+
 
 # jemalloc page size for Apple Silicon (macOS aarch64 uses 16KB pages = 2^14).
 # This target-prefixed env var is consumed by tikv-jemalloc-sys's build.rs
@@ -79,3 +85,15 @@ AARCH64_APPLE_DARWIN_JEMALLOC_SYS_WITH_LG_PAGE = "14"
 AARCH64_UNKNOWN_LINUX_GNU_JEMALLOC_SYS_WITH_LG_PAGE = "16"
 AARCH64_UNKNOWN_LINUX_MUSL_JEMALLOC_SYS_WITH_LG_PAGE = "16"
 AARCH64_UNKNOWN_LINUX_MUSL_JEMALLOC_SYS_WITH_BACKGROUND_THREADS = "0"
+
+# --- Local addition: cross C toolchain for armv7-unknown-linux-gnueabihf (zig).
+# Consumed by cc-rs / build scripts (aws-lc-sys, ring, zstd-sys, jemalloc...).
+CC_armv7_unknown_linux_gnueabihf = "@GROK_ROOT@/tools/cross/zigcc-armv7.sh"
+CXX_armv7_unknown_linux_gnueabihf = "@GROK_ROOT@/tools/cross/zigcc-armv7.sh"
+AR_armv7_unknown_linux_gnueabihf = "@GROK_ROOT@/tools/cross/zigar.sh"
+RANLIB_armv7_unknown_linux_gnueabihf = "@GROK_ROOT@/tools/cross/zigranlib.sh"
+# ripgrep has no auto-download asset for linux-arm; bundle this official
+# ripgrep 15.2.0 armv7-unknown-linux-gnueabihf binary instead (build.rs override).
+GROK_TOOLS_BUNDLE_RG_PATH = "@GROK_ROOT@/tools/cross/rg-armv7"
+# Same override for xai-grok-shell's own rg bundling (separate env var).
+GROK_SHELL_BUNDLE_RG_PATH = "@GROK_ROOT@/tools/cross/rg-armv7"
